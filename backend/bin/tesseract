#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
export LD_LIBRARY_PATH="$BACKEND_DIR/opt/tesseract/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
export TESSDATA_PREFIX="$BACKEND_DIR/opt/tesseract/usr/share/tesseract-ocr/5/tessdata"
exec "$BACKEND_DIR/opt/tesseract/usr/bin/tesseract" "$@"
