# ==============================================================================
# BlockIntel: Production & Global SQL Configuration
# ==============================================================================

# Application Environment
APP_NAME=BlockIntel
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# BlockIntel supports both local SQLite and any production Global SQL database.
# Simply set DATABASE_URL to your cloud database connection string.

# [OPTION 1 - RECOMMENDED] Neon Serverless PostgreSQL (Instant, Autoscaling, Free Tier)
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sweet-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# [OPTION 2 - RECOMMENDED] Supabase Managed PostgreSQL (Database + Global Storage)
# DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# [OPTION 3] CockroachDB Serverless (True Global Multi-Region Consensus)
# DATABASE_URL=postgresql+asyncpg://user:password@global-host.cockroachlabs.cloud:26257/defaultdb?sslmode=require

# [OPTION 4 - DEFAULT] Local SQLite Development Storage
DATABASE_URL=sqlite+aiosqlite:///data/blockintel.db

# ------------------------------------------------------------------------------
# BLOCKCHAIN & VAULT SETTINGS
# ------------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_CHAIN_ID=1337
MAX_FILE_SIZE_BYTES=15728640
